{
  "name": "videoai-worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Worker de processamento do VideoAI Studio: fila de tarefas, FFmpeg e provedores de IA",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --experimental-strip-types src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/index.js",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@fal-ai/client": "^1.10.1",
    "@google/genai": "^2.32.0",
    "@runwayml/sdk": "^4.22.0",
    "@supabase/supabase-js": "^2.118.0",
    "gsap": "3.15.0",
    "hyperframes": "0.9.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
