// Cloudflare Workers (site estático). O painel do Cloudflare roda `npx wrangler deploy`,
// que executa o build abaixo e publica a pasta dist.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "videomarx",
  "compatibility_date": "2026-10-01",
  "build": {
    "command": "npm ci && npm run build"
  },
  "assets": {
    "directory": "./dist",
    // rotas do React (ex.: /transformar) sempre abrem o index.html
    "not_found_handling": "single-page-application"
  }
}
